{
  "schema_version": 2,
  "domain": "dating-platforms",
  "field_tested": {
    "date": "2026-05-03",
    "note": "Tinder login, visible recs, sidebar entries, conversation DOM, and message extraction selectors confirmed in transcript 70fbfcd8-2a6f-468c-a65c-5eae4b248e16. Direct Tinder API/localStorage access forbidden because they triggered account restriction risk. Full chat extraction allowed through slow UI-only crawl with checkpointing (see chat-audit.md). Hinge and Feeld remain deferred pending feasibility testing."
  },
  "path_types": [
    "browser"
  ],
  "forbidden": [
    "automated account creation",
    "credential entry from screenshots",
    "bypassing CAPTCHA without user consent",
    "sending messages without passing consent gate",
    "modifying account settings without user request",
    "extracting or storing other users' photos",
    "creating fake profiles or misrepresenting identity",
    "unmatching without explicit user request",
    "making purchases or using premium features without request",
    "direct Tinder API calls or api.gotinder.com access",
    "reading Tinder auth tokens from localStorage or cookies",
    "automated traversal of many conversations via API or script (slow UI-only crawl is allowed, see chat-audit.md)"
  ],
  "execution_policy": {
    "stop_on": [
      "success",
      "block_detected",
      "captcha",
      "auth_required",
      "user_cancelled",
      "session_limit_reached"
    ],
    "fallback_on": [
      "selector_drift",
      "slow_load",
      "partial_content"
    ],
    "never_fallback_to": [
      "credential_entry",
      "account_creation",
      "unconfirmed_message_send",
      "bypassing_captcha",
      "ignoring_block"
    ],
    "receipt_required": [
      "primitive_id",
      "platform",
      "path_type",
      "fallback_attempts",
      "status",
      "action_count",
      "block_or_captcha_encountered"
    ]
  },
  "primitives": [
    {
      "id": "browser_read_profile_card",
      "path_type": "browser",
      "primary": "capture_screenshot() plus js() DOM extraction from current card",
      "fallback_chain": [
        "screenshot_profile_card_fallback"
      ],
      "inputs": [
        "platform",
        "current_tab"
      ],
      "outputs": [
        "name",
        "age",
        "bio",
        "photos_count",
        "prompts",
        "job",
        "education",
        "distance",
        "lifestyle_tags"
      ],
      "evidence": [
        "screenshot captured",
        "visible text fields extracted"
      ],
      "platform_details": {
        "tinder": {
          "status": "PARTIALLY_CONFIRMED",
          "mechanism": "capture_screenshot() + js() extraction",
          "selectors": {
            "card_container": "region \"Card stack\"",
            "name_age": "button \"{name} {age} Open profile\"",
            "photos_carousel": "region \"{name}'s photos\"",
            "photo_tabs": "tab \"Photo {N}\"",
            "photo_nav_prev": "button \"Previous Photo\"",
            "photo_nav_next": "button \"Next photo\"",
            "profile_detail": "TO_BE_FIELD_TESTED"
          },
          "notes": "Card name/age and photo carousel confirmed. Profile details (bio, prompts, job, education, distance, lifestyle) need field testing after expanding profile card."
        },
        "hinge": {
          "status": "DEFERRED",
          "mechanism": "Mobile-first platform. No confirmed web interface.",
          "notes": "Feasibility test required before building selectors."
        },
        "feeld": {
          "status": "DEFERRED",
          "mechanism": "Web interface exists but may be limited.",
          "notes": "Feasibility test required before building selectors."
        }
      }
    },
    {
      "id": "browser_swipe_decision",
      "path_type": "browser",
      "primary": "keyboard shortcut or visible like/pass/super-like control",
      "fallback_chain": [
        "visible_action_button_click"
      ],
      "inputs": [
        "platform",
        "direction"
      ],
      "outputs": [
        "success",
        "match",
        "match_id"
      ],
      "evidence": [
        "screenshot after swipe",
        "match notification checked"
      ],
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "mechanism": "Keyboard shortcut (preferred) or button click",
          "selectors": {
            "like_button": "button \"LIKE\"",
            "nope_button": "button \"NOPE\"",
            "super_like_button": "button \"SUPER LIKE\"",
            "keyboard_like": "Right arrow",
            "keyboard_nope": "Left arrow",
            "keyboard_super_like": "Enter"
          },
          "notes": "Keyboard shortcuts preferred — more reliable and human-like."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    },
    {
      "id": "browser_read_chat_list",
      "path_type": "browser",
      "primary": "js() extraction from chat sidebar DOM",
      "fallback_chain": [
        "sidebar_screenshot_scroll"
      ],
      "inputs": [
        "platform"
      ],
      "outputs": [
        "conversations"
      ],
      "evidence": [
        "extracted chat entries with names, match IDs, last messages, unread/new-match flags"
      ],
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "mechanism": "DOM extraction from sidebar",
          "selectors": {
            "sidebar": "complementary role container",
            "match_entry": "link \"{name} {optional_badge} {name}\"",
            "avatar": "image \"{name}\"",
            "new_match_badge": "image \"New match\"",
            "likes_received": "link \"Prioritised likes {N} likes\"",
            "likes_sent": "link \"Likes sent\""
          },
          "notes": "Sidebar shows subset — may need to scroll to load more entries."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    },
    {
      "id": "browser_read_conversation_dom",
      "path_type": "browser",
      "primary": "UI-only conversation reading from visible browser page via DOM extraction",
      "fallback_chain": [
        "conversation_screenshot_scroll"
      ],
      "inputs": [
        "platform",
        "match_id"
      ],
      "outputs": [
        "messages"
      ],
      "evidence": [
        "visible conversation page reviewed with DOM extraction"
      ],
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "mechanism": "DOM extraction via evaluate_script. No API calls, no token reading.",
          "selectors": {
            "conversation_log": "[role='log']",
            "message_article": "[role='article']",
            "sender": "strong.Hidden",
            "message_text": "span.text",
            "timestamp": "time",
            "is_user_sent": "sender textContent === 'You'"
          },
          "notes": "Scroll up within [role='log'] to load older messages. Saturation at 3 consecutive zero-new scrolls."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    },
    {
      "id": "browser_extract_all_chats",
      "path_type": "browser",
      "primary": "slow UI-only crawl with checkpointing — scroll sidebar to discover chats, navigate to each, extract messages via DOM",
      "fallback_chain": [
        "conversation_screenshot_scroll"
      ],
      "inputs": [
        "platform"
      ],
      "outputs": [
        "chat_list",
        "threads"
      ],
      "evidence": [
        "extraction-state.json checkpoint with per-conversation message counts"
      ],
      "consent_gate": true,
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "mechanism": "Two-phase crawl: (1) sidebar scroll to discover all chat links, (2) navigate to each chat and extract messages via DOM with scroll-up saturation",
          "selectors": {
            "sidebar_link": "nav a[href*='/app/messages/']",
            "conversation_log": "[role='log']",
            "message_article": "[role='article']",
            "sender": "strong.Hidden",
            "message_text": "span.text",
            "timestamp": "time"
          },
          "notes": "Resumable across sessions. No hard cap on conversations — pacing rules self-limit. 3-6s between nav, 2-4s between scrolls, 8-15s between conversations. Checkpoint after each conversation. See chat-audit.md for full protocol."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    },
    {
      "id": "browser_send_message",
      "path_type": "browser",
      "primary": "type into message textbox, then dispatch Enter or click SEND",
      "fallback_chain": [
        "send_button_click"
      ],
      "inputs": [
        "platform",
        "message"
      ],
      "outputs": [
        "success",
        "sent_text"
      ],
      "evidence": [
        "sent message visible in chat thread",
        "input field cleared"
      ],
      "consent_gate": true,
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "mechanism": "Type into input field, then dispatch Enter or click send button",
          "selectors": {
            "message_input": "textbox \"Type a message ...\"",
            "send_button": "button \"SEND\""
          },
          "notes": "Input is multiline. Send button is disabled when empty."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    },
    {
      "id": "browser_navigate_to_platform",
      "path_type": "browser",
      "primary": "new_tab(platform_url) plus wait_for_content() and logged-in indicator check",
      "fallback_chain": [],
      "inputs": [
        "platform"
      ],
      "outputs": [
        "logged_in",
        "url"
      ],
      "evidence": [
        "url",
        "screenshot",
        "logged-in or not-logged-in indicators"
      ],
      "platform_details": {
        "tinder": {
          "status": "CONFIRMED",
          "urls": {
            "recs": "https://tinder.com/app/recs",
            "messages": "https://tinder.com/app/messages",
            "likes_you": "https://tinder.com/app/likes-you",
            "my_likes": "https://tinder.com/app/my-likes",
            "explore": "https://tinder.com/app/explore",
            "profile": "https://tinder.com/app/profile"
          },
          "logged_in_indicators": [
            "navigation \"Navigation bar\" present with link \"Profile photo You\"",
            "tab \"Matches\" and tab \"Messages\" in sidebar",
            "region \"Card stack\" visible on /app/recs",
            "Page title format: \"(N) Tinder\""
          ],
          "not_logged_in_indicators": [
            "Redirect to tinder.com landing/login page",
            "\"Get started\" modal or phone number entry form"
          ]
        },
        "hinge": {
          "status": "DEFERRED",
          "urls": {}
        },
        "feeld": {
          "status": "DEFERRED",
          "urls": {
            "web": "https://feeld.com"
          }
        }
      }
    },
    {
      "id": "browser_detect_match",
      "path_type": "browser",
      "primary": "capture_screenshot plus match overlay detection after like",
      "fallback_chain": [
        "match_dom_check"
      ],
      "inputs": [
        "platform"
      ],
      "outputs": [
        "matched",
        "match_name",
        "match_id"
      ],
      "evidence": [
        "screenshot or DOM evidence of match notification"
      ],
      "platform_details": {
        "tinder": {
          "status": "NEEDS_FIELD_TESTING",
          "mechanism": "Watch for modal/overlay after LIKE that produces a match",
          "selectors": {
            "match_overlay": "TO_BE_FIELD_TESTED — \"It's a Match!\" modal"
          },
          "notes": "Trigger a match to capture exact DOM structure and auto-dismiss behavior."
        },
        "hinge": {
          "status": "DEFERRED"
        },
        "feeld": {
          "status": "DEFERRED"
        }
      }
    }
  ],
  "fallback_nodes": [
