  "fallback_dags": {
    "read_profile": [
      "browser_read_profile_card"
    ],
    "execute_swipe": [
      "browser_swipe_decision"
    ],
    "detect_match": [
      "browser_detect_match"
    ],
    "read_chats": [
      "browser_read_chat_list",
      "browser_read_conversation_dom",
      "browser_extract_all_chats"
    ],
    "send_message": [
      "browser_send_message"
    ],
    "connect_platform": [
      "browser_navigate_to_platform"
    ]
  },
  "verification_probes": {
    "platform_loaded": {
      "positive": [
        "url contains platform domain",
        "profile cards or matches visible"
      ],
      "negative": [
        "login page visible",
        "block page visible",
        "blank page"
      ]
    },
    "profile_readable": {
      "positive": [
        "name visible",
        "age visible",
        "profile text or photo carousel visible"
      ],
      "negative": [
        "empty profile card",
        "blurred content",
        "loading spinner"
      ]
    },
    "message_sent": {
      "positive": [
        "sent message visible in chat thread",
        "input field cleared"
      ],
      "negative": [
        "input field still contains text",
        "error toast visible"
      ]
    },
    "match_detected": {
      "positive": [
        "match overlay or notification visible",
        "new match in chat list"
      ],
      "negative": [
        "no overlay",
        "standard next profile showing"
      ]
    }
  }
}
