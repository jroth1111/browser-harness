# Optional local browser-harness settings. Copy to src/browser_harness/.env only
# for machine-local development; do not commit real credentials or session URLs.

# Use an explicit local Chrome DevTools endpoint.
# BH_CDP_URL=http://127.0.0.1:9222
# BH_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>

# Allow a user-owned non-loopback CDP endpoint. Leave unset by default.
# BH_CDP_ALLOW_REMOTE=1

# Browser Use cloud API key for remote browser sessions.
# BROWSER_USE_API_KEY=
